# Скопируй в .env и заполни своими значениями
# cp .env.example .env

POSTGRES_USER=defi
POSTGRES_PASSWORD=YOUR_PASSWORD_HERE
POSTGRES_DB=defidb
DATABASE_URL=postgresql+asyncpg://defi:YOUR_PASSWORD_HERE@db:5432/defidb

REDIS_PASSWORD=YOUR_REDIS_PASSWORD
REDIS_URL=redis://:YOUR_REDIS_PASSWORD@redis:6379/0

# Генерировать: openssl rand -hex 32
SECRET_KEY=YOUR_SECRET_KEY_HERE
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Генерировать: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=YOUR_FERNET_KEY_HERE

WEB3_PROVIDER_URL=http://hardhat:8545
CHAIN_ID=31337
TOKEN_CONTRACT_ADDRESS=

DEBUG=true
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:80"]
